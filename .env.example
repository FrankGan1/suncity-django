# Copy this file to .env and fill in real values.
# .env is loaded automatically by suncity_django/settings.py (python-dotenv).

# --- Core -------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Nairobi

# --- MySQL database -----------------------------------------------------
DB_NAME=suncity_django
DB_USER=suncity_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (used to send "reset password" links) -----------------------
# Local/dev default — prints emails to the console, no server needed:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production example (uncomment and configure for real delivery):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@suncitydjango.local

# --- Production security toggles (only used when DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
